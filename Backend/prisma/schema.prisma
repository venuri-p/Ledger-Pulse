generator client{
    provider = "prisma-client-js"
}

datasource db{
    provider = "postgresql"
    url = env("DATABASE_URL")
}

//------------------
//ENUMS
//------------------

enum TransactionType{
    INCOME
    EXPENSE
}

enum AccountType{
    CASH
    BANK
    CREDIT_CARD
    SAVINGS
    OTHER 
}

/*MODELS*/

//--------------------
//USER
//--------------------

model User {
    id            String     @id @default(uuid())
    email         String     @unique
    passwordHash  String     @map("password_hash")

    createdAt     DateTime   @default(now()) @map(created_at")
    updatedAt     DateTime   @updatedAt   @map("updatedAt")

//relationships
accounts Account[]
categories    Category[]
transactions  Transaction[]

@@map("users")
}

//------------------------------------------
//Account
//------------------------------------------

model Account{
    id         String          @id @default(uuid())
    name       String
    type       AccountType

    //starting balance when the account was created 
    openingBalance      Decimal       @db.Decimal(15,2)

    //ISO-style currency code 
    currency       String        @default("LKR")

    isActive       Boolean       @default(true)

    createdAt      DateTime      @default(now()) @map("created_at")
    updatedAt      DateTime      @updatedAt  @map("updatedAt")

    //Foreign key
    userId         String        @map("userId")
    user           User          @relation(
        fields: [userId],
        references: [id],
        onDelete: Cascade
    )

    //relationships
    transactions   Transaction[]

    @@index([userId])
    @@map("accounts")
}

//-------------------------------------
//Category
//-------------------------------------

model Category{
    id            String     @id @default(uuid())
    name          String
    type          TransactionType

    createdAt     DateTime   @default(now()) @map(created_at")

    //NULL ->  Global category
    //Value -> User-defined category
    userId        String?     @map("user_id")

    //foreign key and relationships
    user          User?     @relation(
        fields: [userId], 
        references: [id], 
        onDelete: Cascade)

    //relationships
    transactions  Transaction[]

    @@index([userId])
    @@map("categories")
}

//-------------------------------------
//Transaction
//-------------------------------------

model Transaction{
    id              String    @id @default(uuid())

    //always stored as a positive value.
    //transaction type determines whether it increases or decreases the balance.
    amount          Decimal           @db.Decimal(15,2)

    type            TransactionType

    date            DateTime          @default(now())

    notes           String?

    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt  @map("updatedAt")

//----------------------------------------
//Account relationship
//----------------------------------------

accountId         String       @map("account_id")

account           Account      @relation(
    fields: [accountId],
    references: [id],
    onDelete: Restrict
)

//--------------------------------------
//Category relationship
//--------------------------------------

categoryId        String         @map("category_id")

category          Category      @relation(
    fields: [categoryId],
    references: [id],
    onDelete: Restrict
)

//--------------------------------------
//Indexes
//--------------------------------------

//useful for getting transactions for an account within a particular date range
@@index([accountId, date])

//useful for reports such as: expense by category
@@index([categoryId, date])

@@map("transactions")
}